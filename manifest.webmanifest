{
  "name": "Kura",
  "short_name": "Kura",
  "description": "A notebook home for paper notes and AI: write instantly, scan handwritten pages with Brain Camera, sort into DROP, STOCK, MAKE and TODAY.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#111110",
  "theme_color": "#111110",
  "categories": ["productivity"],
  "icons": [
    { "src": "icon-192.png?v=18", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png?v=18", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png?v=18", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "share_title", "text": "share_text", "url": "share_url" }
  },
  "shortcuts": [
    { "name": "New note", "short_name": "Note", "url": "./?do=note", "icons": [{ "src": "icon-192.png?v=18", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Scan a page", "short_name": "Scan", "url": "./?do=scan", "icons": [{ "src": "icon-192.png?v=18", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Focus timer", "short_name": "Focus", "url": "./?do=focus", "icons": [{ "src": "icon-192.png?v=18", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Plan my day", "short_name": "Plan", "url": "./?do=plan", "icons": [{ "src": "icon-192.png?v=18", "sizes": "192x192", "type": "image/png" }] }
  ]
}
